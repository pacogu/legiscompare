# Copiar como variable de entorno en Netlify (Site settings > Environment variables)
# Marcar "Contains secret values" al crearla.

# API de Google Gemini - gratuita, sin tarjeta de credito requerida.
# Usada tanto para la busqueda (con Google Search grounding) como para el
# borrador de sintesis comparada por eje. Si se agota la cuota gratuita,
# el sitio cae automaticamente al directorio local de fuentes oficiales
# (site/data/fuentes_oficiales.json), asi la busqueda nunca queda vacia.
# Se obtiene en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini
