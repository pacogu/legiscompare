# Copiar como variable de entorno en Netlify (Site settings > Environment variables)
CONGRESS_API_KEY=tu_api_key_de_congress.gov

# API de Google Gemini, para el borrador de sintesis comparada por eje
# (gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini

# Francia (Legifrance, API PISTE) - registro gratis en piste.gouv.fr
LEGIFRANCE_CLIENT_ID=tu_client_id
LEGIFRANCE_CLIENT_SECRET=tu_client_secret

# Nueva Zelanda - se solicita por correo a contact@pco.govt.nz
NZ_LEGISLATION_API_KEY=tu_api_key
