# Copiar como variable de entorno en Netlify (Site settings > Environment variables)
# Marcar "Contains secret values" al crearla.

# API de Groq - gratuita, sin tarjeta de credito requerida.
# Groq no tiene busqueda web propia en el nivel gratuito, asi que se usa
# para analizar el catalogo local de fuentes oficiales (site/data/fuentes_oficiales.json)
# y redactar notas de que buscar en cada una, sin inventar el nombre de
# leyes especificas.
# Se obtiene en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
