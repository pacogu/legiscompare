# Copiar como variable de entorno en Netlify (Site settings > Environment variables)
# Marcar "Contains secret values" al crearla.

# API de AI/ML API (aimlapi.com) - usa el modelo perplexity/sonar, hecho
# para busqueda web con resultados y citas reales. Usada tanto para la
# busqueda como para el borrador de sintesis comparada por eje.
# Se obtiene en https://aimlapi.com/app/keys
AIMLAPI_API_KEY=tu_api_key_de_aimlapi
