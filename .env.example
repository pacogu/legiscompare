# Copiar como variable de entorno en Netlify (Site settings > Environment variables)
# Marcar "Contains secret values" al crearla.

# API de Anthropic (Claude) - usada tanto para la busqueda (con la
# herramienta web_search) como para el borrador de sintesis comparada por eje.
# Se obtiene en https://console.anthropic.com/settings/keys (requiere saldo/plan).
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
